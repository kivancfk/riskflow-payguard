# RiskFlow PayGuard runtime configuration.
#
# Copy this file to .env only for local development.
# Do not commit production database credentials or other secrets.
#
# The frozen policy versions, calibration method, thresholds, SHA-256,
# explanation version, and reason-code version are defined in application
# code and are intentionally not runtime configuration knobs.

# Native local execution defaults to SQLite.
DATABASE_URL=sqlite:///./predictions.db

# Native Streamlit Product Demo calls the locally running FastAPI service.
PAYGUARD_API_URL=http://localhost:8000

# Optional Docker Compose PostgreSQL bootstrap settings.
# These are local-development values only. Production credentials belong
# in the deployment platform's secret/configuration store.
POSTGRES_DB=riskflow
POSTGRES_USER=riskflow
POSTGRES_PASSWORD=riskflow-local
