# Copy to .env for local dev
MODEL_PATH=models/fraud_model.pkl
DATABASE_URL=sqlite:///./predictions.db

# Decision thresholds (probability cutoffs)
THRESHOLD_REVIEW=0.30
THRESHOLD_BLOCK=0.70

# Business cost knobs used by /threshold-simulation
COST_PER_FALSE_POSITIVE=5.0
COST_PER_FALSE_NEGATIVE=100.0
COST_PER_REVIEW=2.0
